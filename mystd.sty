% ==============================================================================
% 9. thm environments
% ==============================================================================
\theoremstyle{definition}

% tcolorbox configs
\tcbset{
    proofstyle/.style={
        breakable,
        enhanced,
        colback=gray!10,
        colframe=gray!40,
        sharp corners,
        boxrule=0.5pt,
        left=1em,
        right=1em,
        top=1ex,
        bottom=1ex,
        before skip=\topsep,
        after skip=3\baselineskip,
        attach title to upper={\par\vspace{0.5ex}\@minipagetrue}
    }
}

% styles
\declaretheoremstyle[
    headfont=\sffamily\bfseries\color{BoxColor1},
    bodyfont=\normalfont,
    spaceabove=\topsep,
    spacebelow=\topsep
]{exoStyle}

\declaretheoremstyle[
    headfont=\sffamily\bfseries\color{AccColor1},
    bodyfont=\itshape,
    spaceabove=\topsep,
    spacebelow=\topsep
]{thmStyle}

\declaretheoremstyle[
    headfont=\sffamily\bfseries\color{green!40!black},
    bodyfont=\normalfont,
    spaceabove=\topsep,
    spacebelow=\topsep
]{defStyle}

% env declare
\declaretheorem[style=exoStyle, name=Exercice, numbered=yes]{exop}
\declaretheorem[style=thmStyle, name=Théorème, numbered=yes]{thm}
\declaretheorem[style=thmStyle, name=Proposition, sharenumber=thm]{prop}
\declaretheorem[style=defStyle, name=Définition, sharenumber=thm]{defn}
\declaretheorem[name=Remarques, numbered=no]{remarks}

% exo env wrap
\NewDocumentEnvironment{exo}{o}{%
    \needspace{4\baselineskip}%
    \setlist[enumerate,2]{label=\arabic*.}%
    \setlist[enumerate,3]{label=(\alph*)}%
    \setlist[enumerate,1]{leftmargin=0em,label=\roman*.)}%
    \IfValueTF{#1}{%
        \begin{exop}[#1]%
        \addcontentsline{toc}{subsubsection}{#1}%
    }{%
        \begin{exop}%
        \addcontentsline{toc}{subsubsection}{Exercice \theexop}%
    }%
    \hfill\begin{enumerate}\item[]%
}{%
    \end{enumerate}\end{exop}\vskip.54em
}

% formal proof env
\renewenvironment{proof}[1][D\'emonstration]{%
    \par
    \pushQED{\qed}%
    \normalfont
    \begin{tcolorbox}[proofstyle, title={#1.}, coltitle=black, fonttitle=\bfseries]
}{%
    \popQED
    \end{tcolorbox}
}

% exercise solution env
\newenvironment{solution}[1][\'El\'ements de r\'eponse]{%
    \par
    \pushQED{\qed}%
    \normalfont
    \begin{tcolorbox}[proofstyle, title={#1.}, coltitle=black, fonttitle=\bfseries\itshape]
}{%
    \popQED
    \end{tcolorbox}
}

